# --- Database ----------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/annveachung?schema=public"

# --- Auth.js (NextAuth v5) --------------------------------------------
# Generate a strong secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-strong-random-secret"
# Set to "true" when running behind a proxy or on http://localhost in dev.
AUTH_TRUST_HOST="true"

# --- Seeded admin credentials -----------------------------------------
# Used ONLY by `prisma db seed` to create/update the admin user (the password
# is bcrypt-hashed before it is stored — the plaintext is never persisted).
# After the first seed you can change the password in the admin panel under
# "Account", and these values are no longer needed at runtime.
ADMIN_USERNAME="annvea"
ADMIN_PASSWORD="change-me-before-deploying"
