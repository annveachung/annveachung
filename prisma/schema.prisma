// Prisma schema for "Annvea's Soft Coastal Space"
// Every public-page section is DB-backed so the admin panel can manage it.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (macOS); the second target is the production
  // server (x86_64 Ubuntu 22.04/24.04, OpenSSL 3.0.x) that CI builds for.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth ---------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Site-wide singleton (hero, nav brand, footer, map meta) -----------

model SiteSettings {
  id            Int    @id @default(1)
  // Hero / brand
  brandName     String @default("Annvea Chung")
  heroTitle     String @default("Coastal Tech")
  heroSubtitle  String @default("Architecting immersive digital experiences at the intersection of technical precision and artistic whimsy.")
  ctaLabel      String @default("Connect")
  ctaHref       String @default("#")
  // visited.json world-map meta
  mapTitle      String @default("visited.json")
  mapSubtitle   String @default("Every country I've set foot in, gently illuminated — a quiet map of where the journey has taken me so far.")
  mapFocus      String @default("Systems Synthesis")
  mapLatency    String @default("24ms")
  // Footer
  footerTagline String @default("Built for the Nocturnal Shoreline")
  updatedAt     DateTime @updatedAt
}

// --- Navigation links ---------------------------------------------------

model NavLink {
  id    String @id @default(cuid())
  label String
  href  String @default("#")
  order Int    @default(0)
}

// --- Social / footer links ---------------------------------------------

model SocialLink {
  id    String @id @default(cuid())
  label String
  href  String @default("#")
  order Int    @default(0)
}

// --- Language marquee greetings ----------------------------------------

model Greeting {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

// --- Skill Tree nodes (living-CV progression graph) --------------------
// Drives the homepage Education / Experience / Skills columns via `category`.

model SkillTreeNode {
  id           String   @id @default(cuid())
  title        String                          // role / degree (education & experience) or skill name
  category     String   @default("skill")      // education | experience | skill
  city         String   @default("")           // city (education & experience cards)
  organization String   @default("")           // institution / company (education & experience cards)
  icon         String   @default("")           // uploaded icon URL (skill nodes)
  status       String   @default("completed")  // completed | learning | planned
  // Parent node ids this node connects back toward the root. Empty = root.
  parents     String[] @default([])
  order       Int      @default(0)
}

// --- Visited countries (visited.json world map) ------------------------

model VisitedCountry {
  id    String @id @default(cuid())
  // `code` = numeric ISO 3166-1 id matching the world-atlas topojson feature id.
  code  String @unique
  name  String
  order Int    @default(0)
}

// --- Visual Logs gallery images ----------------------------------------

model GalleryImage {
  id      String @id @default(cuid())
  url     String
  caption String @default("")
  order   Int    @default(0)
}
